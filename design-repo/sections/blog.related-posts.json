{
  "id": "blog.related-posts",
  "family": "mars",
  "category": "content",
  "purpose": "'You might also like' title row + up to three flush related cards (omitted when a post has none).",
  "variants": {
    "default": "/blog/:slug"
  },
  "implementedBy": [
    {
      "path": "src/components/ContentSections.jsx",
      "lines": "281-293",
      "quote": "export function RelatedPosts"
    }
  ],
  "content": {
    "type": "object",
    "properties": {
      "title": {
        "const": "You might also like"
      },
      "cards": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string",
              "minLength": 1,
              "x-linkField": true,
              "description": "internal path (/..., #...) or https URL on an allowed outbound domain (policies/link-kinds.json)"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxWords": 3
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxWords": 20
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxWords": 30
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxWords": 5
            },
            "image": {
              "type": "object",
              "properties": {
                "assetRole": {
                  "enum": [
                    "blog.cover"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^(/assets/[A-Za-z0-9_./-]+|generate:.{8,200})$",
                  "description": "an existing clone asset path, or generate:<brief> ONLY for roles whose generationPolicy is may-generate-new"
                },
                "alt": {
                  "type": "string",
                  "maxWords": 14
                }
              },
              "additionalProperties": false,
              "required": [
                "assetRole",
                "ref",
                "alt"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "href",
            "tag",
            "title",
            "description",
            "author",
            "image"
          ]
        },
        "minItems": 1,
        "maxItems": 3
      }
    },
    "additionalProperties": false,
    "required": [
      "title",
      "cards"
    ]
  },
  "constraints": {},
  "motion": {
    "allowedPatterns": [
      "blog-card-hover"
    ],
    "reducedMotionFallback": "transitions-disabled"
  },
  "responsive": {
    "390": {
      "cards": "stacked gap 24"
    },
    "810": {
      "cards": "stacked"
    },
    "1200": {
      "cards": "3 flush"
    },
    "evidence": [
      {
        "path": "src/components/ContentSections.jsx",
        "lines": "285",
        "quote": "grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-0"
      }
    ]
  }
}
