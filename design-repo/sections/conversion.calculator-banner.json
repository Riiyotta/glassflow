          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ]
      },
      "background": {
        "type": "object",
        "properties": {
          "assetRole": {
            "enum": [
              "texture.dither-field",
              "scene.mars-figurative"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^(/assets/[A-Za-z0-9_./-]+|generate:.{8,200})$",
            "description": "an existing clone asset path, or generate:<brief> ONLY for roles whose generationPolicy is may-generate-new"
          },
          "alt": {
            "type": "string",
            "maxWords": 14
          }
        },
        "additionalProperties": false,
        "required": [
          "assetRole",
          "ref",
          "alt"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "title",
      "sub",
      "cta",
      "background"
    ]
  },
