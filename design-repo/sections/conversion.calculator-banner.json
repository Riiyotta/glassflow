      "title": {
        "type": "string",
        "minLength": 1,
        "maxWords": 10
      },
      "sub": {
        "type": "string",
        "minLength": 1,
        "maxWords": 25
      },
      "cta": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxWords": 4
          },
          "href": {
            "type": "string",
