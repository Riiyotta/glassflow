{
  "id": "conversion.calculator-banner",
  "family": "mars",
  "category": "conversion",
  "purpose": "450px image banner linking to the build-vs-buy calculator.",
  "variants": {
    "default": "/rius/pricing"
  },
  "implementedBy": [
    {
      "path": "src/pages/RiusPricing.jsx",
