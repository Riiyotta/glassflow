          "alt": {
            "type": "string",
            "maxWords": 14
          }
        },
        "additionalProperties": false,
        "required": [
          "assetRole",
          "ref",
          "alt"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "title",
      "lead",
      "logoStrip",
      "form",
      "background"
