                "lastname",
                "email",
                "which_glassflow_solution_are_you_interested_in",
                "message"
              ]
            },
            "minItems": 3,
            "maxItems": 5
          },
          "solutions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxWords": 2
            },
            "minItems": 2,
            "maxItems": 2
          },
          "submitLabel": {
            "const": "submit"
          },
          "endpointPolicy": {
            "const": "must-not-reuse-live-endpoint"
          },
          "onSuccess": {
            "const": "navigate:/contact/success"
          }
        },
        "additionalProperties": false,
        "required": [
          "fields",
          "solutions",
          "submitLabel",
          "endpointPolicy",
          "onSuccess"
