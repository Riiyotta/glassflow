      "title": {
        "type": "string",
        "minLength": 1,
        "maxWords": 4
      },
      "lead": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxWords": 16
        },
        "minItems": 1,
        "maxItems": 3
      },
      "logoStrip": {
        "type": "object",
        "properties": {
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxWords": 8
          },
          "logos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assetRole": {
                  "enum": [
                    "logo.third-party"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^(/assets/[A-Za-z0-9_./-]+|generate:.{8,200})$",
                  "description": "an existing clone asset path, or generate:<brief> ONLY for roles whose generationPolicy is may-generate-new"
                },
                "alt": {
                  "type": "string",
                  "maxWords": 14
                }
              },
              "additionalProperties": false,
              "required": [
                "assetRole",
                "ref",
                "alt"
              ]
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "additionalProperties": false,
        "required": [
          "caption",
          "logos"
        ]
      },
      "form": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "enum": [
