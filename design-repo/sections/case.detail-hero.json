        "required": [
          "assetRole",
          "ref",
          "alt"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "chip",
      "title",
      "background"
    ]
  },
  "constraints": {
    "onePerPage": true
  },
  "motion": {
    "allowedPatterns": [],
    "reducedMotionFallback": "none-needed"
  },
  "responsive": {
    "390": {},
    "810": {},
